{
  "openapi": "3.0.3",
  "info": {
    "title": "MT-Predictor Backend API",
    "description": "Хакатон Московского транспорта · Трек №3. Go Core: телеметрия NDTP, REST, WebSocket, DSS Holding.",
    "version": "0.2.0",
    "contact": {
      "name": "teamv39 / Денис"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Go backend"
    }
  ],
  "tags": [
    { "name": "system", "description": "Health and status" },
    { "name": "fleet", "description": "Vehicles, route, alerts" },
    { "name": "dss", "description": "Decision support (Holding)" },
    { "name": "simulation", "description": "Demo feeder control" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["system"],
        "summary": "Liveness probe",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "healthy" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "version": { "type": "string", "example": "0.2.0" },
                    "ndtp_listening": { "type": "boolean" },
                    "ndtp_connections": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/status": {
      "get": {
        "tags": ["system"],
        "summary": "System status for TopBar",
        "operationId": "getStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SystemStatus" }
              }
            }
          }
        }
      }
    },
    "/api/v1/route": {
      "get": {
        "tags": ["fleet"],
        "summary": "Demo route geometry (M3 scenario)",
        "operationId": "getRoute",
        "responses": {
          "200": {
            "description": "Route metadata and polyline"
          }
        }
      }
    },
    "/api/v1/vehicles": {
      "get": {
        "tags": ["fleet"],
        "summary": "Active vehicles (demo feeder + live NDTP)",
        "operationId": "getVehicles",
        "responses": {
          "200": {
            "description": "Vehicle list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Vehicle" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alerts": {
      "get": {
        "tags": ["fleet"],
        "summary": "Predictive alerts with SHAP factors",
        "operationId": "getAlerts",
        "responses": {
          "200": {
            "description": "Alert feed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Alert" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations/{id}/apply": {
      "post": {
        "tags": ["dss"],
        "summary": "Apply Holding recommendation",
        "operationId": "applyRecommendation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "alert_001"
          }
        ],
        "responses": {
          "200": {
            "description": "Recommendation applied",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "applied" },
                    "recommendation": { "type": "string" },
                    "holding_active": { "type": "boolean" },
                    "dispatched_to": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/simulation/control": {
      "post": {
        "tags": ["simulation"],
        "summary": "Control demo feeder playback",
        "operationId": "simulationControl",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["action"],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": ["play", "pause", "speed", "reset"]
                  },
                  "speed": {
                    "type": "number",
                    "example": 5.0
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated"
          }
        }
      }
    },
    "/api/v1/ndtp/stats": {
      "get": {
        "tags": ["telemetry"],
        "summary": "NDTP and ML client ingestion statistics",
        "description": "Returns connection counts, packet rates, and ML latency / fallback statistics.",
        "operationId": "getNdtpStats",
        "responses": {
          "200": {
            "description": "Ingestion statistics"
          }
        }
      }
    },
    "/ws": {
      "get": {
        "tags": ["fleet"],
        "summary": "WebSocket telemetry stream",
        "description": "Upgrade to WebSocket. Messages: TELEMETRY_UPDATE, HOLDING_APPLIED.",
        "operationId": "websocket",
        "responses": {
          "101": {
            "description": "Switching Protocols"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SystemStatus": {
        "type": "object",
        "properties": {
          "live_simulation_active": { "type": "boolean" },
          "engine_latency_ms": { "type": "number", "example": 3.2 },
          "active_vehicles_count": { "type": "integer" },
          "active_alerts_count": { "type": "integer" },
          "prevented_incidents_count": { "type": "integer" },
          "punctuality_rate": { "type": "number", "example": 94.8 },
          "simulation_speed": { "type": "number", "example": 1.0 },
          "ndtp_listening": { "type": "boolean" },
          "ndtp_packets": { "type": "integer" },
          "ndtp_connections": { "type": "integer" },
          "ml_ok": { "type": "integer" },
          "ml_fallback": { "type": "integer" }
        }
      },
      "Vehicle": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "1043" },
          "route_id": { "type": "string" },
          "trip_id": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "bearing": { "type": "number" },
          "speed_kmh": { "type": "number" },
          "delay_seconds": { "type": "number" },
          "headway_seconds": { "type": "number" },
          "next_stop_id": { "type": "string" },
          "next_stop_name": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" },
          "status": {
            "type": "string",
            "enum": ["ON_TIME", "DELAYED", "BUNCHING_RISK"]
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "vehicle_id": { "type": "string" },
          "route_id": { "type": "string" },
          "type": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
          },
          "probability": { "type": "number" },
          "estimated_time_to_incident": { "type": "integer", "description": "nanoseconds (Go duration JSON)" },
          "message": { "type": "string" },
          "factors": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SHAPFactor" }
          },
          "recommendation": { "$ref": "#/components/schemas/Recommendation" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SHAPFactor": {
        "type": "object",
        "properties": {
          "feature": { "type": "string" },
          "title": { "type": "string" },
          "weight": { "type": "number" },
          "impact_score": { "type": "number" }
        }
      },
      "Recommendation": {
        "type": "object",
        "properties": {
          "action_type": { "type": "string", "example": "HOLDING" },
          "target_vehicle_id": { "type": "string" },
          "hold_stop_id": { "type": "string" },
          "hold_stop_name": { "type": "string" },
          "duration_seconds": { "type": "integer" },
          "predicted_impact": { "type": "string" },
          "applied": { "type": "boolean" }
        }
      }
    }
  }
}
