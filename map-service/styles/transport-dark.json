{
  "version": 8,
  "name": "Moscow Transport Dark Style",
  "metadata": {
    "maputnik:renderer": "mbgljs"
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "/tiles/data/moscow-transport.json"
    }
  },
  "glyphs": "/tiles/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0d0e12"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": [
        "any",
        ["==", "class", "park"],
        ["==", "class", "grass"],
        ["==", "class", "forest"],
        ["==", "class", "recreation_ground"]
      ],
      "paint": {
        "fill-color": "#064e3b",
        "fill-opacity": 0.15
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#0c253b",
        "fill-opacity": 0.7,
        "fill-outline-color": "#0369a1"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#0284c7",
        "line-opacity": 0.5,
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 2]
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#27272a",
        "line-width": 0.8,
        "line-dasharray": [5, 3]
      }
    },

    {
      "id": "road-minor-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "minor"],
        ["==", "class", "service"],
        ["==", "class", "tertiary"],
        ["==", "class", "street"]
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "#18181b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1, 14, 2.5, 16, 5]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "minor"],
        ["==", "class", "service"],
        ["==", "class", "tertiary"],
        ["==", "class", "street"]
      ],
      "minzoom": 12,
      "paint": {
        "line-color": "#27272a",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.6, 14, 1.8, 16, 4]
      }
    },
    {
      "id": "road-major-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "motorway"],
        ["==", "class", "trunk"],
        ["==", "class", "primary"],
        ["==", "class", "secondary"]
      ],
      "paint": {
        "line-color": "#09090b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 2, 11, 4.5, 14, 8, 16, 13]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "motorway"],
        ["==", "class", "trunk"],
        ["==", "class", "primary"],
        ["==", "class", "secondary"]
      ],
      "paint": {
        "line-color": "#3f3f46",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1, 11, 3, 14, 5.5, 16, 10]
      }
    },

    {
      "id": "road-busway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "busway"],
        ["==", "bus", "designated"],
        ["==", "subclass", "busway"]
      ],
      "minzoom": 10,
      "paint": {
        "line-color": "#0284c7",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 3, 14, 6, 16, 9],
        "line-opacity": 0.3
      }
    },
    {
      "id": "road-busway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "busway"],
        ["==", "bus", "designated"],
        ["==", "subclass", "busway"]
      ],
      "minzoom": 10,
      "paint": {
        "line-color": "#38bdf8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 14, 3, 16, 5],
        "line-dasharray": [3, 1.5]
      }
    },

    {
      "id": "railway-rail-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": {
        "line-color": "#18181b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 1, 12, 2.5, 15, 4]
      }
    },
    {
      "id": "railway-rail-ties",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "rail"],
      "paint": {
        "line-color": "#3f3f46",
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 12, 1.8, 15, 3],
        "line-dasharray": [1.5, 2]
      }
    },

    {
      "id": "railway-tram-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "tram"],
      "minzoom": 12,
      "paint": {
        "line-color": "#09090b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 1.5, 14, 2.5, 16, 3.5]
      }
    },
    {
      "id": "railway-tram",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "tram"],
      "minzoom": 12,
      "paint": {
        "line-color": "#52525b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.8, 14, 1.5, 16, 2],
        "line-dasharray": [2, 2]
      }
    },

    {
      "id": "railway-subway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": [
        "any",
        ["==", "class", "subway"],
        ["==", "class", "transit"]
      ],
      "minzoom": 9,
      "paint": {
        "line-color": "#52525b",
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 13, 2, 16, 2.5],
        "line-dasharray": [3, 3],
        "line-opacity": 0.3
      }
    },

    {
      "id": "poi-railway-station-circle",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": [
        "all",
        ["==", "class", "railway"],
        ["any",
          ["==", "subclass", "station"],
          ["==", "subclass", "halt"]
        ]
      ],
      "minzoom": 10,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 2.5, 12, 4, 14, 5.5],
        "circle-color": "#18181b",
        "circle-stroke-color": "#52525b",
        "circle-stroke-width": 1.5
      }
    },
    {
      "id": "poi-railway-station-dot",
      "type": "circle",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": [
        "all",
        ["==", "class", "railway"],
        ["any",
          ["==", "subclass", "station"],
          ["==", "subclass", "halt"]
        ]
      ],
      "minzoom": 10,
      "paint": {
        "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 1.2, 12, 2, 14, 2.8],
        "circle-color": "#71717a"
      }
    },
    {
      "id": "poi-railway-station-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": [
        "all",
        ["==", "class", "railway"],
        ["any",
          ["==", "subclass", "station"],
          ["==", "subclass", "halt"]
        ]
      ],
      "minzoom": 11,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"], ["get", "name:en"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 13, 11, 15, 12],
        "text-offset": [0, 1.2],
        "text-anchor": "top",
        "text-max-width": 8,
        "text-optional": true,
        "text-allow-overlap": false,
        "icon-allow-overlap": true
      },
      "paint": {
        "text-color": "#cbd5e1",
        "text-halo-color": "#09090b",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    },

    {
      "id": "water-name-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 10,
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 14, 13],
        "text-letter-spacing": 0.15,
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#38bdf8",
        "text-halo-color": "#0c253b",
        "text-halo-width": 1.5
      }
    },

    {
      "id": "road-name",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "coalesce",
          ["get", "name:ru"],
          ["get", "name"],
          ["get", "name:en"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 9, 15, 11],
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#a1a1aa",
        "text-halo-color": "#0d0e12",
        "text-halo-width": 2
      }
    },

    {
      "id": "place-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "any",
        ["==", "class", "city"],
        ["==", "class", "town"],
        ["==", "class", "suburb"],
        ["==", "class", "quarter"],
        ["==", "class", "neighbourhood"]
      ],
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"],
          8, ["match", ["get", "class"], "city", 14, "town", 12, 10],
          12, ["match", ["get", "class"], "city", 18, "town", 15, "suburb", 13, 11],
          15, ["match", ["get", "class"], "city", 22, "town", 18, "suburb", 15, "quarter", 13, 12]
        ],
        "text-max-width": 10,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#cbd5e1",
        "text-halo-color": "#0d0e12",
        "text-halo-width": 2,
        "text-halo-blur": 0.5
      }
    }
  ]
}
